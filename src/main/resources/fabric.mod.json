{
	"schemaVersion": 1,
	"id": "minecraftgmail",
	"version": "${version}",
	"name": "MinecraftGmail",
	"description": "A Fabric mod bringing Gmail into Minecraft.",
	"authors": [
		"Loganwall111"
	],
	"contact": {
		"homepage": "https://github.com/Loganwall111/minecraftgmail",
		"sources": "https://github.com/Loganwall111/minecraftgmail"
	},
	"license": "CC0-1.0",
	"icon": "assets/minecraftgmail/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.loganwall111.minecraftgmail.MinecraftGmailMod"
		],
		"client": [
			"io.github.loganwall111.minecraftgmail.client.MinecraftGmailClient"
		]
	},
	"mixins": [
		"minecraftgmail.mixins.json",
		{
			"config": "minecraftgmail.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}